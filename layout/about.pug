- const setting = Object.assign({}, theme, page)
//- The page body lives in source/about/index.md; the config only carries the
//- section labels and the webmaster card, so front matter can override either.
- const mergeAboutBlock = key => Object.assign({}, (theme.aboutPage || {})[key] || {}, (page.aboutPage || {})[key] || {})
- const aboutWebsite = mergeAboutBlock('website')
- const aboutWebmaster = mergeAboutBlock('webmaster')
body.page-body.boxed-container.about-page
  nav.navbar.horizontal-menu.navbar-fixed-top
    .navbar-inner
      .navbar-brand
        a(href=url_for('/index.html')).logo
          img.hidden-xs(src=url_for(theme.logo.expanded), width='180px', alt=config.title)
          img.visible-xs(src=url_for(theme.logo.expanded), width='180px', alt=config.title)
        a.navbar-back(href=url_for('/index.html') aria-label='返回上一页' title='返回上一页' onclick='if (history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }')
          i.fas.fa-angle-left(aria-hidden='true')
          span 返回
      .navbar-mobile-clear
      if theme.githubCorner
        != theme.githubCorner

  .page-container
    main#main-content.main-content
      .row
        .col-md-12
          .panel.panel-default
            if aboutWebsite.head
              h4.text-gray= aboutWebsite.head
            if page.content
              .panel-body!= page.content
            if aboutWebmaster.head
              h4.text-gray= aboutWebmaster.head
            if aboutWebmaster.name
              .row
                .col-sm-12.col-md-6
                  a.resource-card(href=url_for(aboutWebmaster.url) target='_blank' rel='noopener noreferrer')
                    span.resource-icon
                      img(src=url_for(aboutWebmaster.img) width='40' height='40' alt='')
                    span.resource-copy
                      strong.resource-name= aboutWebmaster.name
                      span.resource-description= aboutWebmaster.description
  include common/footer
