- const setting = Object.assign({}, theme, page)
//- Everything on this page comes from source/about/index.md. No configuration
//- key is read here any more: headings, text and the webmaster card (a
//- one-item Markdown list of links) are all part of the file.
body.page-body.boxed-container.about-page
  nav.navbar.horizontal-menu.navbar-fixed-top
    .navbar-inner
      .navbar-brand
        a(href=url_for('/index.html')).logo
          img.hidden-xs(src=url_for(theme.logo.expanded), width='180px', alt=config.title)
          img.visible-xs(src=url_for(theme.logo.expanded), width='180px', alt=config.title)
        a.navbar-back(href=url_for('/index.html') aria-label='返回上一页' title='返回上一页' onclick='if (history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) { history.back(); return false; }')
          i.fas.fa-angle-left(aria-hidden='true')
          span 返回
      .navbar-mobile-clear
      if theme.githubCorner
        != theme.githubCorner

  .page-container
    main#main-content.main-content
      .row
        .col-md-12
          .panel.panel-default
            if page.content
              .panel-body!= page.content
  include common/footer
