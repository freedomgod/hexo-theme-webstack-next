- const sectionId = menuName.replace(/[\s]+/g, '-')
- const gridId = sectionId + '-grid'
section.resource-section(aria-label=menuName)
  .section-heading
    h2.text-gray(id=sectionId)
      button.section-toggle(type='button' aria-expanded='true' aria-controls=gridId title='收起或展开「' + menuName + '」')
        i.linecons-tag(aria-hidden='true')
        span.section-title= menuName
        i.fas.fa-chevron-down.section-chevron(aria-hidden='true')
    span.section-count(aria-label=menus.length + ' 个网站')= menus.length
  .resource-grid(id=gridId)
    each menu in menus
      - const tags = typeof menu.tags === 'string' ? menu.tags.split(/[,，]/).map(tag => tag.trim()).filter(Boolean) : []
      - const image = (typeof menu.img === 'string' && menu.img.trim()) ? url_for(menu.img) : bookmarkAvatar(menu.name)
      - const cardTitle = [menu.name, menu.description].filter(Boolean).join(' · ')
      a.resource-card(href=url_for(menu.url) target='_blank' rel='noopener noreferrer' title=cardTitle)
        span.resource-icon
          img(src=image loading='lazy' decoding='async' width='40' height='40' alt='' onerror="this.hidden = true")
        span.resource-copy
          strong.resource-name= menu.name
          if menu.description
            span.resource-description= menu.description
        if tags.length
          span.resource-tags
            each tag in tags
              span.resource-tag= tag
        i.fas.fa-arrow-up.resource-arrow(aria-hidden='true')
